<!DOCTYPE html>
<html lang="en">
<head>
  <script src="/components/site-gtm.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Primary SEO -->
  <title><%= post.metaTitle || (post.title + ' | Verifitech Blog') %></title>
  <meta name="description" content="<%= post.metaDescription %>">
  <% if (post.focusKeyword || (post.tags && post.tags.length)) { %>
  <meta name="keywords" content="<%= [post.focusKeyword].concat(post.tags || []).filter(Boolean).join(', ') %>">
  <% } %>
  <meta name="author" content="<%= post.author %>">
  <meta name="robots" content="<%= isPreview ? 'noindex, nofollow' : robots + (robots.indexOf('noindex') === -1 ? ', max-image-preview:large' : '') %>">
  <link rel="canonical" href="<%= canonical %>">

  <!-- Open Graph (per-post overrides: Blog admin → Social sharing) -->
  <meta property="og:type" content="<%= og.type %>">
  <meta property="og:site_name" content="Verifitech">
  <meta property="og:title" content="<%= og.title %>">
  <meta property="og:description" content="<%= og.description %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= og.image %>">
  <meta property="og:image:secure_url" content="<%= og.image %>">
  <meta property="og:image:alt" content="<%= og.imageAlt %>">
  <meta property="og:locale" content="en_IN">
  <% if (og.type === 'article') { %>
  <% if (post.publishedAt) { %><meta property="article:published_time" content="<%= post.publishedAt %>"><% } %>
  <meta property="article:modified_time" content="<%= post.updatedAt %>">
  <% postCats.forEach(function (c) { %><meta property="article:section" content="<%= c.name %>">
  <% }) %><% (post.tags || []).forEach(function (t) { %><meta property="article:tag" content="<%= t %>">
  <% }) %>
  <% } %>

  <!-- Twitter / X -->
  <meta name="twitter:card" content="<%= og.twitterCard %>">
  <meta name="twitter:title" content="<%= og.title %>">
  <meta name="twitter:description" content="<%= og.description %>">
  <meta name="twitter:image" content="<%= og.image %>">
  <meta name="twitter:image:alt" content="<%= og.imageAlt %>">

  <link rel="icon" href="/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script type="application/ld+json"><%- jsonLd %></script>
  <%- include('blog-partials-style') %>

  <% if (settings.headCode) { %><!-- Site-wide custom head code (Blog admin → Settings) -->
  <%- settings.headCode %>
  <% } %>
  <% if (post.customHead) { %><!-- Custom head code for this post -->
  <%- post.customHead %>
  <% } %>
</head>
<body>
  <% if (isPreview) { %>
  <div class="vt-preview-bar">Draft preview — only logged-in admins can see this page. <a href="/blog-admin">Back to admin</a></div>
  <% } %>

  <script src="/components/site-header.js"></script>
  <site-header></site-header>

  <main>
    <article class="vt-post-wrap" itemscope itemtype="https://schema.org/BlogPosting">
      <nav class="vt-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>›</span><a href="/resources/blog">Blog</a>
        <% if (postCats[0]) { %><span>›</span><a href="/blog/category/<%= postCats[0].slug %>"><%= postCats[0].name %></a><% } %>
      </nav>

      <header>
        <% if (postCats.length) { %>
        <div class="vt-cats">
          <% postCats.forEach(function (c) { %>
            <a class="vt-cat" href="/blog/category/<%= c.slug %>" rel="tag"><%= c.name %></a>
          <% }) %>
        </div>
        <% } %>
        <h1 class="vt-title" itemprop="headline"><%= post.title %></h1>
        <div class="vt-meta">
          <span><i class="bi bi-person"></i><span itemprop="author"><%= post.author %></span></span>
          <% var d = post.publishedAt || post.createdAt; %>
          <span><i class="bi bi-calendar3"></i><time datetime="<%= d %>" itemprop="datePublished"><%= new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time></span>
          <span><i class="bi bi-clock"></i><%= readTime %> min read</span>
        </div>
      </header>

      <% if (post.featuredImage) { %>
      <img class="vt-featured" src="<%= post.featuredImage %>" alt="<%= post.featuredImageAlt || post.title %>" itemprop="image" fetchpriority="high">
      <% } %>

      <div class="vt-content" itemprop="articleBody">
        <%- post.content %>

        <% if (post.tags && post.tags.length) { %>
        <div class="vt-tags">
          <% post.tags.forEach(function (t) { %><span class="vt-tag">#<%= t %></span><% }) %>
        </div>
        <% } %>

        <div class="vt-share">
          <strong>Share:</strong>
          <a target="_blank" rel="noopener" aria-label="Share on LinkedIn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(canonical) %>"><i class="bi bi-linkedin"></i></a>
          <a target="_blank" rel="noopener" aria-label="Share on X" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(canonical) %>"><i class="bi bi-twitter-x"></i></a>
          <a target="_blank" rel="noopener" aria-label="Share on Facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonical) %>"><i class="bi bi-facebook"></i></a>
          <a target="_blank" rel="noopener" aria-label="Share on WhatsApp" href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' ' + canonical) %>"><i class="bi bi-whatsapp"></i></a>
          <button type="button" aria-label="Copy link" onclick="navigator.clipboard.writeText('<%= canonical %>');this.innerHTML='<i class=&quot;bi bi-check2&quot;></i>'"><i class="bi bi-link-45deg"></i></button>
        </div>
      </div>
    </article>

    <% if (related.length) { %>
    <section class="vt-related" aria-label="Related articles">
      <h2 class="vt-section-title"><span>Related</span> Articles</h2>
      <div class="vt-grid">
        <% related.forEach(function (r) { %>
        <a class="vt-card" href="<%= r.url %>">
          <div class="vt-card-img">
            <% if (r.featuredImage) { %><img src="<%= r.featuredImage %>" alt="<%= r.featuredImageAlt %>" loading="lazy" onerror="this.onerror=null;this.src='/assets/logos/verifitech-logo.svg';this.alt='Verifitech logo';this.className='is-logo'"><% } else { %><img class="is-logo" src="/assets/logos/verifitech-logo.svg" alt="Verifitech logo" loading="lazy"><% } %>
          </div>
          <div class="vt-card-body">
            <span class="vt-card-cat"><%= r.categories[0] ? r.categories[0].name : 'Insights' %></span>
            <h3><%= r.title %></h3>
            <span class="vt-card-date"><i class="bi bi-calendar3"></i> <%= new Date(r.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
          </div>
        </a>
        <% }) %>
      </div>
    </section>
    <% } %>
  </main>

  <script src="/components/site-contact.js"></script>
  <site-contact></site-contact>
  <script src="/components/site-footer.js"></script>
  <site-footer></site-footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <% if (settings.footerCode) { %><!-- Site-wide custom scripts (Blog admin → Settings) -->
  <%- settings.footerCode %>
  <% } %>
  <% if (post.customScripts) { %><!-- Custom scripts for this post -->
  <%- post.customScripts %>
  <% } %>
</body>
</html>
