    <script>
        // 1. Country Selector Logic
        const countryOptions = document.querySelectorAll('.country-option');
        const currentFlag = document.getElementById('current-flag');
        const currentCountry = document.getElementById('current-country');

        countryOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault(); // Prevent navigation for demo
                const country = this.getAttribute('data-country');
                const flag = this.getAttribute('data-flag');
                
                currentFlag.textContent = flag;
                currentCountry.textContent = country;
            });
        });

        // 2. Dashboard / Suite Interaction Logic
        // When hovering over a suite card, activate the corresponding sidebar item
        const suiteCards = document.querySelectorAll('.suite-card');
        const sidebarItems = document.querySelectorAll('.sidebar-item');

        suiteCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                const trigger = this.getAttribute('data-trigger');
                if(trigger) {
                    // Remove active class from all
                    sidebarItems.forEach(item => item.classList.remove('active', 'pulse-active'));
                    
                    // Find matching sidebar item
                    const activeItem = document.querySelector(`.sidebar-item[data-target="${trigger}"]`);
                    if(activeItem) {
                        activeItem.classList.add('active', 'pulse-active');
                    }
                }
            });
            
            // Optional: Reset on mouse leave if desired, or keep last active
            card.addEventListener('mouseleave', function() {
                 // Keeping the last active for visual feedback, or remove to reset
                 // sidebarItems.forEach(item => item.classList.remove('pulse-active'));
            });
        });

        // Sidebar Click Interaction
        sidebarItems.forEach(item => {
            item.addEventListener('click', function() {
                sidebarItems.forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                
                // Update Title and Description based on selection
                const target = this.getAttribute('data-target');
                const title = document.getElementById('dash-title');
                const desc = document.getElementById('dash-desc');
                
                // Simple content mapping for demo
                const contentMap = {
                    'id': { title: "VERIFY IDENTITY INSTANTLY.", desc: "Validate government IDs like PAN and Aadhaar in real-time." },
                    'global': { title: "GLOBAL DATABASE CHECKS.", desc: "Screen individuals against global watchlists and databases." },
                    'address': { title: "CURRENT ADDRESS PROOF.", desc: "Verify residence details digitally with geotagging." },
                    'criminal': { title: "CRIMINAL BACKGROUND CHECK.", desc: "Fast-track court record verification for safer hiring." },
                    'employment': { title: "EMPLOYMENT HISTORY.", desc: "Instantly verify past employment details via UAN and EPFO." },
                    'education': { title: "EDUCATION CREDENTIALS.", desc: "Validate degrees and certificates directly from universities." }
                };

                if(contentMap[target]) {
                    title.style.opacity = 0;
                    desc.style.opacity = 0;
                    setTimeout(() => {
                        title.innerHTML = contentMap[target].title;
                        desc.innerHTML = contentMap[target].desc;
                        title.style.opacity = 1;
                        desc.style.opacity = 1;
                    }, 200);
                }
            });
        });

        // 3. Number Counter Animation
        const counters = document.querySelectorAll('.counter');
        const speed = 200;

        const animateCounters = () => {
            counters.forEach(counter => {
                const updateCount = () => {
                    const target = +counter.getAttribute('data-target');
                    const count = +counter.innerText;
                    const inc = target / speed;

                    if (count < target) {
                        counter.innerText = Math.ceil(count + inc);
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        };

        // Trigger counter animation when scrolled into view
        let counted = false;
        const statsSection = document.getElementById('stats');
        window.addEventListener('scroll', () => {
            if(!counted && window.scrollY + window.innerHeight > statsSection.offsetTop) {
                animateCounters();
                counted = true;
                // Animate workflow line
                document.getElementById('workflow-line').style.width = "100%";
            }
        });

        // Navbar Scroll Effect
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
