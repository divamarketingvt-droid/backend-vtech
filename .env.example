# =========================================================
#  Verifitech website — environment settings
#  Copy this file to .env and fill in the real values.
#  After editing, restart the server (npm start).
# =========================================================

# ---------- Server ----------
PORT=3000
SITE_URL=https://www.verifitech.com

# ---------- Email (Gmail SMTP, use a Google "App password") ----------
EMAIL_USER=connect@verifitech.com
EMAIL_PASS="your-16-char-gmail-app-password"
ADMIN_EMAIL=connect@verifitech.com

# ---------- Mint Solutions (UAE) enquiry form ----------
# Comma-separated lists
MINT_ENQUIRY_TO=person1@example.com,person2@example.com
MINT_ENQUIRY_CC=
# Send an automatic "thank you" email to the person who enquired (true/false)
MINT_AUTOREPLY=true

# ---------- Blog admin ----------
# Secret used to sign login JWTs. Long random text; changing it logs everyone out.
BLOG_JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (hours)
BLOG_SESSION_HOURS=8
